	issue = {1},
	journal = {IEE Proceedings F (Radar and Signal Processing)},
	pages = {55-62},
	title = {Neural controller based on back-propagation algorithm},
	url = {https://digital-library.theiet.org/doi/abs/10.1049/ip-f-2.1991.0009},
